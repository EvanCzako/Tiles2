{
	"name": "untiled",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write src",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d dist",
		"sim": "tsx scripts/simulate.ts"
	},
	"jest": {
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				{
					"useESM": true
				}
			]
		},
		"extensionsToTreatAsEsm": [
			".ts"
		],
		"moduleNameMapper": {
			"^(\\.{1,2}/.*)\\.js$": "$1"
		},
		"testEnvironment": "node"
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.3.1",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"gh-pages": "^6.3.0",
		"globals": "^17.4.0",
		"jest": "^30.4.1",
		"prettier": "^3.8.1",
		"ts-jest": "^29.4.11",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^6.0.0"
	}
}
